{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/syracuse-jiu-jitsu", "destination": "/index.html" },
    { "source": "/syracuse-jiu-jitsu/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
